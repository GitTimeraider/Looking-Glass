# ---- required ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me-to-something-long
# first admin account (only used when the database has no users yet; change it later in the UI)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now
# MFA (TOTP app or passkey) is enforced at first login.
# Passkeys need HTTPS: set the public https URL when MonRaider runs behind a reverse proxy
PUBLIC_URL=
COOKIE_SECURE=false
# optional: cookie signing key (generated and stored in the database when empty)
SECRET_KEY=
TIMEZONE=Europe/Amsterdam

# ---- OPNsense API (System > Access > Users > API keys) -------------------------
OPNSENSE_URL=https://192.168.1.1
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
OPNSENSE_VERIFY_SSL=false
# OPNSENSE_CA_FILE=/data/opnsense-ca.pem
POLL_INTERVAL=60
# auto = pull firewall log via API only when no filterlog arrives via syslog
FIREWALL_LOG_PULL=auto

# ---- AI analyst (any OpenAI compatible endpoint) -------------------------------
# Claude via Anthropic's OpenAI compatible API:
AI_BASE_URL=https://api.anthropic.com/v1/
AI_MODEL=claude-opus-5-5
AI_API_KEY=
# create an AI-written daily report at this hour (local TIMEZONE)
AI_DAILY_REPORT=false
AI_DAILY_REPORT_HOUR=7

# ---- Zenarmor Elasticsearch-compatible stream receiver (free edition streaming) ----
ZENARMOR_ES_PORT=9200
ZENARMOR_ES_USER=
ZENARMOR_ES_PASSWORD=

# ---- Unraid (optional; add/manage servers in the UI under Integrations) ----------
UNRAID_NAME=Tower
UNRAID_URL=
UNRAID_API_KEY=
UNRAID_DOCKER_URL=

# ---- misc ------------------------------------------------------------------------
RETENTION_DAYS=30
METRICS_RETENTION_DAYS=90
# extra CIDRs to treat as internal (RFC1918 etc. are always internal)
INTERNAL_NETWORKS=
# only accept syslog from these senders (comma separated IPs/CIDRs); empty = everyone
SYSLOG_ALLOWED_SENDERS=
LOG_LEVEL=INFO
