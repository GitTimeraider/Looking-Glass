# Looking Glass - OPTIONAL settings. The standard install needs no .env file at all:
#   * database connection and first login -> setup wizard in the web UI (stored encrypted in ./data)
#   * OPNsense / AI / Zenarmor / Unraid credentials -> Settings in the web UI (stored encrypted in the database)
# Copy to .env only if you need one of the options below.

# ---- container user ------------------------------------------------------------------
# uid:gid the container runs as (compose `user:`); the ./data folder must belong to it:
#   sudo chown -R 10001:10001 ./data     (or whatever numbers you set here, e.g. Unraid 99:100)
#PUID=10001
#PGID=10001

# ---- HTTPS / passkeys (only when behind a reverse proxy) ------------------------------
#PUBLIC_URL=https://looking-glass.home.lan
#COOKIE_SECURE=true

#LOG_LEVEL=INFO
#LOG_AI_REQUESTS=false   # true: log every AI request and what started it

# ---- unattended install (skips the setup wizard) - prefer the *_FILE variants -----------
#DATABASE_URL=postgresql://lookingglass:password@db:5432/lookingglass
#ADMIN_USER=admin
#ADMIN_PASSWORD=
