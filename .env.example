# Looking Glass - environment = infrastructure only.
# Integration settings and credentials (OPNsense API, AI key, Zenarmor, Unraid servers, retention, ...) are NOT set
# here: enter them in the web UI under Settings. They are stored encrypted in the database and applied live.

# ---- database ---------------------------------------------------------------------
# password for the bundled PostgreSQL container (or use Docker secrets: POSTGRES_PASSWORD_FILE + DATABASE_URL_FILE)
POSTGRES_PASSWORD=change-me-to-something-long

# ---- first login --------------------------------------------------------------------
# only used to create the first account when the database is empty; leave ADMIN_PASSWORD empty to get a random
# password printed in the container log. MFA (authenticator app or passkey) is enforced at first login.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---- container user (match your share permissions, e.g. Unraid PUID=99 PGID=100) ------
PUID=10001
PGID=10001

# ---- HTTPS / passkeys (only when behind a reverse proxy) ------------------------------
PUBLIC_URL=
COOKIE_SECURE=false

LOG_LEVEL=INFO
