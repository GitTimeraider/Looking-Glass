# ---- required ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me-to-something-long
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# random string used to sign login cookies (e.g. output of: openssl rand -hex 32)
SECRET_KEY=
TIMEZONE=Europe/Amsterdam

# ---- OPNsense API (System > Access > Users > API keys) -------------------------
OPNSENSE_URL=https://192.168.1.1
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
OPNSENSE_VERIFY_SSL=false
# OPNSENSE_CA_FILE=/data/opnsense-ca.pem
POLL_INTERVAL=60
# auto = pull firewall log via API only when no filterlog arrives via syslog
FIREWALL_LOG_PULL=auto

# ---- AI analyst (any OpenAI compatible endpoint) -------------------------------
# Claude via Anthropic's OpenAI compatible API:
AI_BASE_URL=https://api.anthropic.com/v1/
AI_MODEL=claude-opus-5-5
AI_API_KEY=
# create an AI-written daily report at this hour (local TIMEZONE)
AI_DAILY_REPORT=false
AI_DAILY_REPORT_HOUR=7

# ---- misc ------------------------------------------------------------------------
RETENTION_DAYS=30
METRICS_RETENTION_DAYS=90
# extra CIDRs to treat as internal (RFC1918 etc. are always internal)
INTERNAL_NETWORKS=
# only accept syslog from these senders (comma separated IPs/CIDRs); empty = everyone
SYSLOG_ALLOWED_SENDERS=
LOG_LEVEL=INFO
